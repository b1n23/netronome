[weblate]
url = https://hosted.weblate.org/
name = netronome

[[weblate.components]]
name = frontend
repo = autobrr/netronome
branch = develop
filemask = web/public/locales/*/common.json
template = web/public/locales/en/common.json
file_format = json-nested
new_lang = add
check_flags = ["ignore-placeholders"]

[[weblate.components]]
name = frontend-speedtest
repo = autobrr/netronome
branch = develop
filemask = web/public/locales/*/speedtest.json
template = web/public/locales/en/speedtest.json
file_format = json-nested
new_lang = add

